# Copy to .env.local for local development and fill in values.
# On Vercel, set these in Project Settings -> Environment Variables.

# Canvas LMS (both required to enable the Canvas source)
# Your school's Canvas URL, e.g. https://school.instructure.com
CANVAS_BASE_URL=
# Personal access token from Canvas -> Account -> Settings -> New Access Token
CANVAS_API_TOKEN=

# Course schedule pages to scrape: a JSON array of objects.
# Each object: { "label": "...", "url": "https://..." }
# Optional per page: "course" (display name, defaults to label) and "parser" (defaults to "generic").
COURSE_PAGES=

# IANA timezone used to interpret dates on course pages and to display all due times,
# e.g. America/Los_Angeles. Defaults to UTC.
APP_TIMEZONE=

# Optional: per-source timeout in milliseconds (default 10000).
SOURCE_TIMEOUT_MS=
